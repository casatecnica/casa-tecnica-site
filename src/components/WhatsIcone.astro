---
// Ícone de conversa (Lucide) usado em todos os botões de WhatsApp.
import { MessageCircle } from '@lucide/astro';
interface Props { size?: number; class?: string }
const { size = 20, class: cls = '' } = Astro.props;
---
<MessageCircle size={size} class={cls} aria-hidden="true" stroke-width={2.2} />
